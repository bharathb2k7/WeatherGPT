{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "email"]
    },
    "UserHistory": {
      "title": "UserHistory",
      "description": "Saved weather advisory chat session or query for the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "query": { "type": "string" },
        "reply": { "type": "string" },
        "location": { "type": "string" },
        "language": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["userId", "query", "reply", "timestamp"]
    },
    "SavedLocation": {
      "title": "SavedLocation",
      "description": "User saved favorite weather locations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "admin1": { "type": "string" },
        "country": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "timezone": { "type": "string" },
        "savedAt": { "type": "string" }
      },
      "required": ["userId", "name", "latitude", "longitude"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual user document containing profile and settings"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": "UserHistory",
      "description": "User weather inquiry history"
    },
    "/users/{userId}/savedLocations/{locationId}": {
      "schema": "SavedLocation",
      "description": "User saved favorite places"
    }
  }
}
